ENVIRONMENT=development

# Provider: openai | openai_responses | openai_like | ollama | ceia
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_REASONING_EFFORT=minimal

# Comparative campaign with 300 fixed inputs (OpenRouter).
# The model and parameters come from configs/campaigns/front-a-fixed-300.yaml.
OPENROUTER_API_KEY=

# Ollama/CEIA (used when LLM_PROVIDER=ollama or ceia)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLE_THINKING=true

# Verbose local Agno debugging. It can log prompts and payloads; do not enable it
# globally in production. AgentDebug-RH checkpoints do not depend on this log.
AGNO_DEBUG=false
AGNO_DEBUG_LEVEL=1

# Langfuse project for scenario-emulator. Leaving the three variables empty keeps
# the integration off, so the first smoke test needs only the LLM.
# Put real values in .env; never paste keys into a chat.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# The runtime reads this label; use production in the stable environment.
LANGFUSE_PROMPT_LABEL=dev
# Sync publishes to dev by default and never promotes implicitly.
LANGFUSE_SYNC_LABEL=dev
LANGFUSE_TRACING_ENABLED=true

# Prompt Manager
PROMPT_CACHE_TTL_SECONDS=60
PROMPT_FETCH_TIMEOUT_SECONDS=3
