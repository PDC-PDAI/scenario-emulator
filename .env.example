ENVIRONMENT=development

# Provider: openai | openai_responses | openai_like | ollama | ceia
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_REASONING_EFFORT=minimal

# Ollama/CEIA (usado quando LLM_PROVIDER=ollama ou ceia)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLE_THINKING=true

# Projeto Langfuse do scenario-emulator. Configure no .env; nunca envie chaves no chat.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# O runtime lê este canal; use production no ambiente estável.
LANGFUSE_PROMPT_LABEL=dev
# O sync publica em dev por padrão e nunca promove implicitamente.
LANGFUSE_SYNC_LABEL=dev
LANGFUSE_TRACING_ENABLED=true

# Prompt Manager
PROMPT_CACHE_TTL_SECONDS=60
PROMPT_FETCH_TIMEOUT_SECONDS=3

# API HTTP / Swagger
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_DATABASE_PATH=data/scenario-emulator.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
