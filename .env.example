ENVIRONMENT=development

# Provider: openai | openai_responses | openai_like | ollama | ceia
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_REASONING_EFFORT=minimal

# Ollama/CEIA (usado quando LLM_PROVIDER=ollama ou ceia)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLE_THINKING=true

# Debug verboso local do Agno. Pode registrar prompts e payloads; não habilite
# globalmente em produção. Os checkpoints AgentDebug-RH não dependem deste log.
AGNO_DEBUG=false
AGNO_DEBUG_LEVEL=1

# Projeto Langfuse do scenario-emulator. As três variáveis vazias deixam a
# integração desligada, permitindo o primeiro smoke test somente com o LLM.
# Configure valores reais no .env; nunca envie chaves no chat.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# O runtime lê este canal; use production no ambiente estável.
LANGFUSE_PROMPT_LABEL=dev
# O sync publica em dev por padrão e nunca promove implicitamente.
LANGFUSE_SYNC_LABEL=dev
LANGFUSE_TRACING_ENABLED=true

# Prompt Manager
PROMPT_CACHE_TTL_SECONDS=60
PROMPT_FETCH_TIMEOUT_SECONDS=3
